# Optional: pre-fill Spotify credentials so users don't have to enter them on the Setup page.
# If left empty, each user provides their own credentials through the UI.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# The redirect URI registered in your Spotify app dashboard.
# Must match exactly: http://127.0.0.1:8000/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# URL of the frontend (used for post-auth redirect and CORS).
FRONTEND_URL=http://localhost:5173
