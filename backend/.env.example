# "development" (local) or "production" (deployed).
# Production enables cross-domain cookies (SameSite=None, Secure).
ENVIRONMENT=development

# Optional: pre-fill Spotify credentials so users skip the UI input.
# If empty, each user enters their own on the Setup page.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match the Redirect URI in every user's Spotify app dashboard.
# Local:      http://127.0.0.1:8000/auth/callback
# Production: https://<your-railway-app>.up.railway.app/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# Frontend URL (used for post-auth redirect and CORS).
# Local:      http://localhost:5173
# Production: https://<your-vercel-app>.vercel.app
FRONTEND_URL=http://localhost:5173
